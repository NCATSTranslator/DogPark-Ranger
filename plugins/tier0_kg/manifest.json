{
    "version": "0.2",
    "requires": [
        "jsonlines"
    ],
    "__metadata__": {
        "graph": "https://kgx-storage.ci.transltr.io/releases/translator_kg/2026_06_21/graph-metadata.json"
    },
    "dumper": {
        "data_url": [
            "https://kgx-storage.ci.transltr.io/releases/translator_kg/2026_06_21/translator_kg.tar.zst"
        ],
        "class": "hub.dataload.kgDumper.KgDumper",
        "uncompress": false,
        "schedule": "0 6 * * *"
    },
    "uploaders": [
        {
            "name": "tier0_kg_nodes",
            "parser": "hub.dataload.kg_loader:parser",
            "parser_kwargs": {
                "entity": "nodes",
                "is_tier0": true
            },
            "on_duplicates": "error",
            "mapping": "hub.dataload.mapping.kg_mapping:nodes_mapping",
            "class": "hub.dataload.uploader.KGXUploader"
        },
        {
            "name": "tier0_kg_edges",
            "parser": "hub.dataload.kg_loader:parser",
            "parser_kwargs": {
                "entity": "edges",
                "is_tier0": true,
                "gen_seq": false
            },
            "on_duplicates": "error",
            "mapping": "hub.dataload.mapping.kg_mapping:merged_edges_mapping",
            "class": "hub.dataload.uploader.KGXUploader"
        }
    ]
}
